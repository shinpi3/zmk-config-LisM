#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mb1 {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <16 18>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <16 7>;
        };

        close {
            bindings = <&kp LC(W)>;
            key-positions = <26 27>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <16 17 18 19>;
        };

        mo7 {
            bindings = <&mo 7>;
            key-positions = <16 17 18>;
        };

        mo7l {
            bindings = <&mo 7>;
            key-positions = <11 12 13>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q      &kp W      &kp E           &kp R           &kp T                                            &kp Y           &kp U           &kp I            &kp O     &kp P
&kp A      &kp S      &kp D           &kp F           &kp G                                            &kp H           &kp J           &kp K            &kp L     &kp MINUS
&kp Z      &kp X      &kp C           &kp V           &kp B                                            &kp N           &kp M           &kp COMMA        &kp DOT   &kp SLASH
&kp LCTRL  &kp LSHFT  &kp LALT        &msc SCRL_UP    &lt 1 SPACE      &lt 2 SPACE    &lt 3 BACKSPACE  &lt 5 ENTER     &msc SCRL_UP    &mo 6            &kp LGUI  &lt 4 DELETE
                      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                                  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "layer1";
            bindings = <
&kp ESCAPE    &kp F2  &kp F3  &kp F4      &kp F5                    &kp F6        &kp F7    &kp F8    &kp F9        &kp F10
&kp F1        &trans  &trans  &trans      &trans                    &kp LG(UP)    &mkp MB1  &mkp MB2  &msc SCRL_UP  &kp F11
&kp LS(CAPS)  &trans  &trans  &kp LA(F4)  &trans                    &kp LG(DOWN)  &kp LEFT  &kp UP    &kp RIGHT     &kp F12
&trans        &trans  &trans  &trans      &trans  &trans    &trans  &trans        &trans    &kp DOWN  &trans        &kp LG(W)
                      &trans  &trans      &trans                    &trans        &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>;
        };

        layer_2 {
            display-name = "layer2";
            bindings = <
&trans      &kp NUMBER_7       &kp NUMBER_8    &kp UP_ARROW    &kp LC(D)                                          &kp SINGLE_QUOTE  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp DELETE  &mt LALT NUMBER_4  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW                                    &kp KP_ASTERISK   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS
&kp SLASH   &kp NUMBER_1       &kp NUMBER_2    &kp NUMBER_3    &kp PLUS                                           &kp KP_SLASH      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp COMMA
&trans      &kp DOT            &kp NUMBER_0    &kp UP          &none            &kp LC(LS(END))    &kp BACKSPACE  &kp KP_NUMBER_0   &kp UP           &kp RS(RC(DOT))  &kp RC(DOT)      &kp ENTER
                               &kp LEFT        &kp DOWN        &kp RIGHT                                          &kp LEFT          &kp DOWN         &kp RIGHT
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "layer3";
            bindings = <
&kp LS(LG(N4))  &kp F4   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none                        &kp TILDE  &kp EXCLAMATION  &kp AT_SIGN       &kp HASH           &kp DOLLAR
&emoji          &kp F5   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none                        &kp GRAVE  &kp UNDER        &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp BACKSLASH
&kp KP_NUMLOCK  &kp F11  &kp LEFT_BRACE        &kp RIGHT_BRACE        &none                        &kp PIPE   &kp PERCENT      &kp CARET         &kp AMPERSAND      &kp ASTERISK
&trans          &trans   &kp NUMBER_0          &trans                 &kp SPACE  &trans    &trans  &kp ENTER  &trans           &none             &none              &kp F12
                         &trans                &trans                 &trans                       &trans     &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LG(RIGHT_ARROW)) LC(LG(LEFT_ARROW))>;
        };

        layer_4 {
            display-name = "layer4";
            bindings = <
&none        &none           &none   &none   &bt BT_CLR                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none        &none           &none   &none   &none                                &none         &none         &none         &none         &none
&sys_reset   &none           &none   &none   &none                                &none         &none         &none         &none         &sys_reset
&bootloader  &bt BT_CLR_ALL  &none   &none   &none       &none    &studio_unlock  &none         &none         &none         &none         &bootloader
                             &trans  &trans  &trans                               &trans        &trans        &trans
            >;
        };

        layer_5 {
            display-name = "layer5";
            bindings = <
&kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3      &kp NUMBER_4      &kp NUMBER_5                          &kp NUMBER_6      &kp NUMBER_7       &kp NUMBER_8      &kp NUMBER_9      &kp NUMBER_0
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                      &kp LS(NUMBER_6)  &kp LS(NUMBER_7)   &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp MINUS
&trans            &trans            &trans            &trans            &trans                                &kp F13           &kp RIGHT_BRACKET  &kp BACKSLASH     &kp F16           &kp LEFT_BRACKET
&trans            &trans            &trans            &trans            &trans            &kp F14    &kp F15  &trans            &trans             &trans            &trans            &trans
                                    &trans            &trans            &trans                                &trans            &trans             &trans
            >;
        };

        layer_6 {
            display-name = "layer6";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };

        layer_7 {
            display-name = "layer7";
            bindings = <
&trans  &trans  &trans  &trans  &trans                             &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                             &trans       &none   &none   &none   &trans
&trans  &trans  &trans  &trans  &trans                             &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LS(LC(TAB))  &kp LC(TAB)  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                             &trans       &trans  &trans
            >;
        };
    };
};
